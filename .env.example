# Docker Compose / Portainer
CYRENE_IMAGE=ghcr.io/geber-suprabapak/project-cyrene:latest
BACKEND_NETWORK=skanida-backend

# Runtime
NODE_ENV=production
PORT=3000
TZ=Asia/Jakarta

# Supabase on-prem. Use the internal API gateway/Kong URL reachable on
# BACKEND_NETWORK, not localhost and not the PostgreSQL port.
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_SERVICE_KEY=your-service-role-key

# Shared by Cyrene and the Supabase Database Webhook Authorization header.
API_BEARER_TOKEN=replace-with-a-long-random-secret

# Optional. Required only when Expo Push enhanced security is enabled.
EXPO_ACCESS_TOKEN=
